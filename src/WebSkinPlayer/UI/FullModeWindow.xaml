<Window x:Class="WebSkinPlayer.UI.FullModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vis="clr-namespace:WebSkinPlayer.Visualization"
        Title="WebSkin Player" Width="900" Height="620" MinWidth="560" MinHeight="400"
        Background="{StaticResource Chrome}" Foreground="{StaticResource TextMain}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/app.ico">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#FF2C333D"/>
            <Setter Property="BorderBrush" Value="#FF414B58"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF37404C"/>
                            </Trigger>
                            <Trigger Property="IsDefault" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF1F6FB2"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#FF3FA9F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF175A92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / tabs -->
        <DockPanel x:Name="HeaderBar" Grid.Row="0" Background="{StaticResource ChromeLight}" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="8,4,0,0">
                <RadioButton x:Name="TabNowPlaying" Content="Now Playing" Style="{StaticResource TabButton}" IsChecked="True" Checked="OnTabChanged"/>
                <RadioButton x:Name="TabSkins" Content="Skin Chooser" Style="{StaticResource TabButton}" Checked="OnTabChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,10,0" VerticalAlignment="Center">
                <Button x:Name="UpdateLink" Visibility="Collapsed" Margin="0,0,14,0" Padding="10,3" Background="#FF1F6FB2" BorderBrush="#FF3FA9F5"
                        Click="OnUpdateLink" ToolTip="Open the download page for the new version"/>
                <TextBlock Text="Source" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="SourceBox" Width="190" SelectionChanged="OnSourceChanged" DropDownOpened="OnSourceDropDown"/>
            </StackPanel>
        </DockPanel>

        <!-- Now Playing -->
        <Grid x:Name="NowPlayingPanel" Grid.Row="1" Background="Black">
            <vis:VisualizerView x:Name="Visualizer" MouseLeftButtonDown="OnVisualizerClick" MouseRightButtonUp="OnVisualizerRightClick"
                                ToolTip="Double-click for full screen · right-click to choose a visualization"/>
            <StackPanel x:Name="NowInfo" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,12" IsHitTestVisible="False">
                <TextBlock x:Name="NowTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="NowArtist" FontSize="14" Foreground="#FFB9C4D2" TextTrimming="CharacterEllipsis">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect>
                </TextBlock>
            </StackPanel>
            <Border x:Name="VisControls" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Padding="6,4" CornerRadius="4" Background="#99101418">
                <StackPanel Orientation="Horizontal">
                    <Button Content="&#xE76B;" Style="{StaticResource TransportButton}" Width="26" Height="26" FontSize="11" ToolTip="Previous visualization" Click="OnPrevEffect"/>
                    <ComboBox x:Name="EffectBox" Width="150" Margin="2,0" SelectionChanged="OnEffectSelected"/>
                    <ComboBox x:Name="PresetBox" Width="160" Margin="2,0" SelectionChanged="OnPresetSelected"/>
                    <Button Content="&#xE76C;" Style="{StaticResource TransportButton}" Width="26" Height="26" FontSize="11" ToolTip="Next preset" Click="OnNextPreset"/>
                    <Button Content="&#xE790;" Style="{StaticResource TransportButton}" Width="26" Height="26" FontSize="13" Margin="4,0,0,0" ToolTip="Colors" Click="OnColors"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="NoSessionHint" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="#FF8B95A3"
                       TextAlignment="Center" IsHitTestVisible="False"
                       Text="Start playing something on SoundCloud or Spotify in Chrome.&#x0a;It will show up here, and any skin can control it."/>
        </Grid>

        <!-- Skin Chooser -->
        <Grid x:Name="SkinsPanel" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource Chrome}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Background="{StaticResource ChromeLight}">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,6,4,0">
                    <RadioButton x:Name="SkinsInstalled" GroupName="SkinSource" Content="Installed" Style="{StaticResource TabButton}" Padding="10,4"
                                 IsChecked="True" Checked="OnSkinSourceChanged"/>
                    <RadioButton x:Name="SkinsOnline" GroupName="SkinSource" Content="Get more skins" Style="{StaticResource TabButton}" Padding="10,4"
                                 Checked="OnSkinSourceChanged"/>
                </StackPanel>
                <TextBox x:Name="SkinSearch" DockPanel.Dock="Top" Margin="8,8,8,6" Padding="4,3" TextChanged="OnSkinSearch"
                         Background="#FF1A1E24" Foreground="{StaticResource TextMain}" BorderBrush="#FF39414D" ToolTip="Search skins"/>
                <ComboBox x:Name="PublisherFilter" DockPanel.Dock="Top" Margin="8,0,8,6" SelectionChanged="OnPublisherFilter"
                          ToolTip="Show one publisher's skins"/>
                <TextBlock x:Name="SkinCount" DockPanel.Dock="Bottom" Margin="10,4,10,8" Foreground="{StaticResource TextDim}" FontSize="11"/>
                <ListBox x:Name="SkinList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}"
                         SelectionChanged="OnSkinSelected" MouseDoubleClick="OnSkinDoubleClick"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="6,10,6,3" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}">
                                        <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding ItemCount, Mode=OneWay, StringFormat='  {0}'}"
                                                                                      Foreground="{StaticResource TextDim}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </DockPanel>
            <Grid Grid.Column="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="SkinName" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SkinAuthor" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Row="1" Margin="0,14" Background="#FF0C0E11" CornerRadius="6">
                    <Grid>
                        <Image x:Name="SkinPreview" Stretch="Uniform" StretchDirection="DownOnly" Margin="12" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="SkinPreviewStatus" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2">
                    <StackPanel x:Name="InstalledButtons" Orientation="Horizontal">
                        <Button x:Name="ApplySkin" Content="Apply Skin" Padding="18,6" Click="OnApplySkin" IsDefault="True"/>
                        <Button Content="Install skin file…" Padding="14,6" Margin="10,0,0,0" Click="OnInstallSkin"/>
                        <Button Content="Open skins folder" Padding="14,6" Margin="10,0,0,0" Click="OnOpenSkinsFolder"/>
                    </StackPanel>
                    <StackPanel x:Name="OnlineButtons" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="DownloadSkin" Content="Download and Apply" Padding="18,6" Click="OnDownloadSkin"/>
                        <Button x:Name="DownloadAll" Content="Download all" Padding="14,6" Margin="10,0,0,0" Click="OnDownloadAll"/>
                        <Button x:Name="CancelDownload" Content="Cancel" Padding="14,6" Margin="10,0,0,0" Click="OnCancelDownload" Visibility="Collapsed"/>
                    </StackPanel>
                    <DockPanel x:Name="DownloadRow" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="DownloadStatus" DockPanel.Dock="Right" Margin="10,0,0,0" MinWidth="150" TextAlignment="Right"
                                   Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="DownloadProgress" Height="6" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                     Foreground="{StaticResource Accent}" Background="#FF1A1E24" BorderThickness="0"/>
                    </DockPanel>
                    <TextBlock x:Name="OnlineCredit" Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource TextDim}" Visibility="Collapsed" TextWrapping="Wrap">
                        Skins and screenshots come from the
                        <Hyperlink Click="OnOnlineSourceLink" Foreground="{StaticResource Accent}">Windows Media Player Skins Collection</Hyperlink>
                        on archive.org. Each skin belongs to its original author.
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Transport bar -->
        <Grid x:Name="TransportArea" Grid.Row="2" Background="{StaticResource TransportBar}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="12,6,12,0">
                <TextBlock x:Name="PositionText" DockPanel.Dock="Left" Width="52" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="DurationText" DockPanel.Dock="Right" Width="52" TextAlignment="Right" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center"/>
                <Slider x:Name="SeekBar" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                        Thumb.DragStarted="OnSeekStart" Thumb.DragCompleted="OnSeekEnd" PreviewMouseLeftButtonUp="OnSeekClick"/>
            </DockPanel>
            <Grid Grid.Row="1" Height="62">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0">
                    <Image x:Name="ArtThumb" Width="40" Height="40" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center" MaxWidth="220">
                        <TextBlock x:Name="BarTitle" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BarStatus" FontSize="11" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ToggleButton x:Name="ShuffleBtn" Visibility="Collapsed"/>
                    <Button x:Name="StopBtn" Content="&#xE71A;" Style="{StaticResource TransportButton}" ToolTip="Stop" Click="OnStop"/>
                    <Button x:Name="PrevBtn" Content="&#xE892;" Style="{StaticResource TransportButton}" ToolTip="Previous" Click="OnPrev"/>
                    <Button x:Name="PlayBtn" Content="&#xE768;" Style="{StaticResource PlayButton}" ToolTip="Play" Click="OnPlayPause"/>
                    <Button x:Name="NextBtn" Content="&#xE893;" Style="{StaticResource TransportButton}" ToolTip="Next" Click="OnNext"/>
                    <Button x:Name="MuteBtn" Content="&#xE767;" Style="{StaticResource TransportButton}" ToolTip="Mute" Click="OnMute"/>
                    <Slider x:Name="VolumeBar" Width="90" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="OnVolumeChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0">
                    <Button x:Name="OnTopBtn" Content="&#xE718;" Style="{StaticResource TransportButton}" Click="OnAlwaysOnTop"/>
                    <Button Content="&#xE7F4;" Style="{StaticResource TransportButton}"
                            ToolTip="Turn into taskbar widget (Ctrl+3)" Click="OnWidgetMode"/>
                    <Button Content="&#xE8A7;" Style="{StaticResource TransportButton}"
                            ToolTip="Switch to skin mode (Ctrl+2)" Click="OnSkinMode"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
