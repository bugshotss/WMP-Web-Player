<Project Sdk="Microsoft.NET.Sdk">

  <!-- Draws the README's pictures (docs\images): the backdrop, collage, banner, buttons, and the GIFs made from
       frames the app records with its automation "record" command. Run by tools\Make-ReadmeMedia.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
